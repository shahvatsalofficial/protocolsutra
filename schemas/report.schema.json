{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ProtocolSutra report envelope",
  "type": "object",
  "required": [
    "schemaVersion"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string"
    },
    "gate": {
      "type": "string",
      "enum": [
        "PASS",
        "REVIEW",
        "NO_GO",
        "INCONCLUSIVE"
      ]
    },
    "notice": {
      "type": "string"
    },
    "findings": {
      "type": "array"
    },
    "cases": {
      "type": "array"
    },
    "rows": {
      "type": "array"
    }
  }
}
