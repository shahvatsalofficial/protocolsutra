{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ProtocolSutra MCP Snapshot (app format, not MCP wire protocol)",
  "type": "object",
  "required": [
    "kind",
    "name",
    "protocolVersion",
    "tools"
  ],
  "properties": {
    "kind": {
      "const": "mcp-snapshot"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "protocolVersion": {
      "type": "string"
    },
    "capabilities": {
      "type": "object"
    },
    "tools": {
      "type": "array",
      "maxItems": 500,
      "items": {
        "type": "object",
        "required": [
          "name",
          "inputSchema"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string"
          },
          "inputSchema": {
            "type": "object"
          }
        }
      }
    }
  }
}
